#!/bin/zsh
# ╔══════════════════════════════════════════════╗
# ║   DockFolders                                ║
# ║   macOS Dock Category Organizer              ║
# ║   https://github.com/Geonhee15/dockfolders ║
# ╚══════════════════════════════════════════════╝

set -u
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
unalias ln 2>/dev/null
unalias mkdir 2>/dev/null
unalias rm 2>/dev/null
unalias cp 2>/dev/null
hash -r

readonly VERSION="1.0.0"
readonly SCRIPT_NAME="dockfolders"

# ─── Paths ───
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dockfolders"
readonly CONFIG_FILE="$CONFIG_DIR/config.sh"
readonly DEFAULT_CONFIG_URL="https://raw.githubusercontent.com/Geonhee15/dockfolders/main/config.example.sh"

# ─── Defaults (overridable by config) ───
DOCK_FOLDERS_DIR="$HOME/Applications/DockFolders"
ICONS_DIR="$HOME/.dock_folder_icons"
BACKUP_DIR="$HOME/Desktop"
USE_SPACER=true

# ─── Colors ───
RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'; CYAN=$'\033[0;36m'; MAGENTA=$'\033[0;35m'
BOLD=$'\033[1m'; DIM=$'\033[2m'; NC=$'\033[0m'

# ─── System commands (absolute path for safety) ───
LN="/bin/ln"; MKDIR="/bin/mkdir"; RM="/bin/rm"; CP="/bin/cp"
KILLALL="/usr/bin/killall"; MDFIND="/usr/bin/mdfind"

# ─── Logging ───
log_info()    { echo "${CYAN}ℹ${NC}  $*"; }
log_ok()      { echo "${GREEN}✓${NC}  $*"; }
log_warn()    { echo "${YELLOW}⚠${NC}  $*" >&2; }
log_err()     { echo "${RED}✗${NC}  $*" >&2; }
log_step()    { echo "\n${CYAN}${BOLD}▸${NC} ${BOLD}$*${NC}"; }
log_banner()  {
    echo "${BLUE}${BOLD}"
    echo "╔═══════════════════════════════════════════╗"
    echo "║   📁 DockFolders v${VERSION}                     ║"
    echo "╚═══════════════════════════════════════════╝${NC}"
}

# ─── App Discovery ───
find_app() {
    local name="$1"
    [[ -z "$name" ]] && return 1
    
    local search_paths=(
        "/Applications"
        "/System/Applications"
        "/System/Applications/Utilities"
        "/Applications/Utilities"
        "$HOME/Applications"
        "/Applications/Setapp"
    )
    
    for prefix in "${search_paths[@]}"; do
        [[ -d "$prefix/$name.app" ]] && echo "$prefix/$name.app" && return 0
        [[ -d "$prefix/$name" ]] && echo "$prefix/$name" && return 0
    done
    
    # Spotlight fallback
    if [[ -x "$MDFIND" ]]; then
        local result
        result=$("$MDFIND" "kMDItemContentType == 'com.apple.application-bundle' && kMDItemDisplayName == '$name'" 2>/dev/null | head -1)
        [[ -n "$result" && -d "$result" ]] && echo "$result" && return 0
        
        result=$("$MDFIND" "kMDItemContentType == 'com.apple.application-bundle' && kMDItemFSName == '$name.app'" 2>/dev/null | head -1)
        [[ -n "$result" && -d "$result" ]] && echo "$result" && return 0
    fi
    return 1
}

get_app_icon() {
    local app="$1"
    [[ ! -d "$app" ]] && return 1
    
    local icon
    icon=$(plutil -extract CFBundleIconFile raw "$app/Contents/Info.plist" 2>/dev/null)
    icon="${icon%.icns}"
    
    local path="$app/Contents/Resources/${icon}.icns"
    [[ -f "$path" ]] && echo "$path" && return 0
    return 1
}

# ─── Dependency Check ───
ensure_brew() {
    if ! command -v brew &>/dev/null; then
        log_err "Homebrew not found. Install from https://brew.sh"
        exit 1
    fi
}

ensure_dockutil() {
    if ! command -v dockutil &>/dev/null; then
        ensure_brew
        log_info "Installing dockutil..."
        brew install dockutil || { log_err "Failed to install dockutil"; exit 1; }
    fi
}

ensure_fileicon() {
    if ! command -v fileicon &>/dev/null; then
        ensure_brew
        log_info "Installing fileicon..."
        brew install fileicon || { log_err "Failed to install fileicon"; exit 1; }
    fi
}

ensure_pillow() {
    if python3 -c "from PIL import Image, ImageDraw, ImageFont" 2>/dev/null; then
        return 0
    fi
    log_info "Installing Pillow..."
    python3 -m pip install --user --break-system-packages pillow 2>&1 | tail -2
    python3 -c "from PIL import Image, ImageDraw, ImageFont" 2>/dev/null
}

# ─── Config ───
load_config() {
    local custom_config="${1:-}"
    
    if [[ -n "$custom_config" ]]; then
        if [[ ! -f "$custom_config" ]]; then
            log_err "Config file not found: $custom_config"
            exit 1
        fi
        source "$custom_config"
        log_ok "Loaded config: $custom_config"
        return 0
    fi
    
    if [[ -f "$CONFIG_FILE" ]]; then
        source "$CONFIG_FILE"
        log_ok "Loaded config: $CONFIG_FILE"
        return 0
    fi
    
    log_warn "No config found at $CONFIG_FILE"
    log_info "Creating default config..."
    create_default_config
    source "$CONFIG_FILE"
}

create_default_config() {
    "$MKDIR" -p "$CONFIG_DIR"
    
    # Try to find example config relative to script
    local script_dir="$(cd "$(dirname "$0")" && pwd)"
    local example="$script_dir/config.example.sh"
    
    if [[ -f "$example" ]]; then
        "$CP" "$example" "$CONFIG_FILE"
        log_ok "Default config created at $CONFIG_FILE"
        log_info "Edit it to customize categories and apps"
    else
        log_err "config.example.sh not found"
        exit 1
    fi
}

validate_config() {
    if [[ ${#CATEGORIES[@]} -eq 0 ]]; then
        log_err "No categories defined in config"
        exit 1
    fi
}

# ─── Backup ───
backup_dock() {
    local backup_path="$BACKUP_DIR/dock_backup_$(date +%Y%m%d_%H%M%S)"
    "$MKDIR" -p "$backup_path"
    "$CP" ~/Library/Preferences/com.apple.dock.plist "$backup_path/"
    echo "$backup_path"
}

# ─── Folder Creation ───
create_folders() {
    "$RM" -rf "$DOCK_FOLDERS_DIR"
    "$MKDIR" -p "$DOCK_FOLDERS_DIR"
    
    local total=0
    local skipped=()
    
    for entry in "${CATEGORIES[@]}"; do
        # Parse: "FolderName|Emoji|App1,App2,App3"
        local cat_name="${entry%%|*}"
        local rest="${entry#*|}"
        local emoji="${rest%%|*}"
        local apps_csv="${rest#*|}"
        
        local cat_dir="$DOCK_FOLDERS_DIR/$cat_name"
        "$MKDIR" -p "$cat_dir"
        
        local count=0
        local missing=()
        
        # Split CSV
        local apps=("${(@s:,:)apps_csv}")
        for app in "${apps[@]}"; do
            app="${app## }"; app="${app%% }"  # trim
            [[ -z "$app" ]] && continue
            
            local app_path
            app_path=$(find_app "$app")
            if [[ -n "$app_path" && -d "$app_path" ]]; then
                "$LN" -sf "$app_path" "$cat_dir/${app_path:t}"
                count=$((count + 1))
            else
                missing+=("$app")
            fi
        done
        
        total=$((total + count))
        printf "  ${GREEN}✓${NC} %-18s ${BOLD}%2d${NC} apps" "$cat_name" "$count"
        if [[ ${#missing[@]} -gt 0 ]]; then
            printf "  ${DIM}(skip: ${(j:, :)missing})${NC}"
            skipped+=("${missing[@]}")
        fi
        echo ""
    done
    
    log_ok "Total: $total apps in ${#CATEGORIES[@]} folders"
}

# ─── Icon Generation ───
generate_icons() {
    "$MKDIR" -p "$ICONS_DIR"
    
    if ! ensure_pillow; then
        log_warn "Pillow unavailable - skipping emoji icons"
        return 1
    fi
    
    # Build emoji map from CATEGORIES
    local emoji_pairs=()
    for entry in "${CATEGORIES[@]}"; do
        local cat_name="${entry%%|*}"
        local rest="${entry#*|}"
        local emoji="${rest%%|*}"
        # Category name without prefix: "01.Dev" → "Dev"
        local short="${cat_name#*.}"
        emoji_pairs+=("$short|$emoji")
    done
    
    # Pass to Python via env var
    export DOCKFOLDERS_EMOJI_PAIRS="${(j:;:)emoji_pairs}"
    export DOCKFOLDERS_ICONS_DIR="$ICONS_DIR"
    
    python3 <<'PYEOF'
import os, sys
from PIL import Image, ImageDraw, ImageFont

pairs_str = os.environ.get("DOCKFOLDERS_EMOJI_PAIRS", "")
icons_dir = os.environ.get("DOCKFOLDERS_ICONS_DIR")

if not pairs_str or not icons_dir:
    sys.exit(0)

emoji_map = {}
for pair in pairs_str.split(";"):
    if "|" in pair:
        name, emoji = pair.split("|", 1)
        emoji_map[name] = emoji

font_path = "/System/Library/Fonts/Apple Color Emoji.ttc"
NATIVE = 137
TARGET = 1024

try:
    font = ImageFont.truetype(font_path, NATIVE)
except OSError as e:
    print(f"Font load failed: {e}", file=sys.stderr)
    sys.exit(1)

for name, emoji in emoji_map.items():
    canvas = NATIVE * 2
    img = Image.new("RGBA", (canvas, canvas), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img)
    bbox = draw.textbbox((0, 0), emoji, font=font, embedded_color=True)
    w, h = bbox[2] - bbox[0], bbox[3] - bbox[1]
    x = (canvas - w) / 2 - bbox[0]
    y = (canvas - h) / 2 - bbox[1]
    draw.text((x, y), emoji, font=font, embedded_color=True)
    img = img.resize((TARGET, TARGET), Image.LANCZOS)
    img.save(f"{icons_dir}/{name}.png")
    print(f"  ✓ {name} {emoji}")
PYEOF
}

apply_icons() {
    ensure_fileicon
    
    # Build fallback app map from ICON_FALLBACK if defined
    typeset -A fallback_map
    if [[ -n "${ICON_FALLBACK+x}" ]]; then
        for entry in "${ICON_FALLBACK[@]}"; do
            local key="${entry%%|*}"
            local val="${entry#*|}"
            fallback_map[$key]="$val"
        done
    fi
    
    for folder in "$DOCK_FOLDERS_DIR"/*/; do
        local folder_clean="${folder%/}"
        local folder_name="${folder_clean:t}"
        local category="${folder_name#*.}"
        
        local icon_path=""
        local src=""
        
        # Try emoji icon first
        if [[ -f "$ICONS_DIR/${category}.png" ]]; then
            icon_path="$ICONS_DIR/${category}.png"
            src="emoji"
        # Then fallback app icon
        elif [[ -n "${fallback_map[$category]:-}" ]]; then
            local app_path
            app_path=$(find_app "${fallback_map[$category]}")
            if [[ -n "$app_path" ]]; then
                icon_path=$(get_app_icon "$app_path")
                src="app:${fallback_map[$category]}"
            fi
        fi
        
        if [[ -n "$icon_path" && -f "$icon_path" ]]; then
            if fileicon set "$folder_clean" "$icon_path" >/dev/null 2>&1; then
                printf "  ${GREEN}✓${NC} %-18s ${DIM}(%s)${NC}\n" "$folder_name" "$src"
            fi
        fi
    done
}

# ─── Dock Setup ───
setup_dock() {
    ensure_dockutil
    
    # Clear apps section
    dockutil --remove all --no-restart 2>/dev/null
    
    # Add favorites
    if [[ -n "${FAVORITES+x}" ]]; then
        for fav in "${FAVORITES[@]}"; do
            local fav_path
            fav_path=$(find_app "$fav")
            if [[ -n "$fav_path" && -d "$fav_path" ]]; then
                if dockutil --add "$fav_path" --no-restart 2>/dev/null; then
                    printf "  ${GREEN}✓${NC} %s\n" "$fav"
                fi
            else
                log_warn "Favorite not found: $fav"
            fi
        done
    fi
    
    # Spacer
    if [[ "${USE_SPACER:-true}" == "true" ]]; then
        defaults write com.apple.dock persistent-apps -array-add \
            '{"tile-type"="spacer-tile";}' 2>/dev/null
        printf "  ${GREEN}✓${NC} spacer\n"
    fi
    
    # Clear others section
    dockutil --remove all --section others --no-restart 2>/dev/null
    
    # Add category folders
    for folder in "$DOCK_FOLDERS_DIR"/*/; do
        if [[ -d "$folder" ]]; then
            local folder_clean="${folder%/}"
            if dockutil --add "$folder_clean" \
                --view grid --display folder --sort name \
                --section others --no-restart 2>/dev/null; then
                printf "  ${GREEN}✓${NC} %s\n" "${folder_clean:t}"
            fi
        fi
    done
    
    "$KILLALL" Dock 2>/dev/null
    sleep 1
}

# ─── Subcommands ───
cmd_organize() {
    local config_path=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --config) config_path="$2"; shift 2 ;;
            *) log_err "Unknown option: $1"; exit 1 ;;
        esac
    done
    
    log_banner
    
    log_step "[1/6] Loading config"
    load_config "$config_path"
    validate_config
    
    log_step "[2/6] Backing up Dock"
    local backup_path
    backup_path=$(backup_dock)
    log_ok "Backup: $backup_path"
    
    log_step "[3/6] Creating category folders"
    create_folders
    
    log_step "[4/6] Generating emoji icons"
    generate_icons
    
    log_step "[5/6] Applying icons to folders"
    apply_icons
    
    log_step "[6/6] Setting up Dock"
    setup_dock
    
    echo "\n${GREEN}${BOLD}╔═══════════════════════════════════════════╗${NC}"
    echo "${GREEN}${BOLD}║   ✨ Done!                                ║${NC}"
    echo "${GREEN}${BOLD}╚═══════════════════════════════════════════╝${NC}"
    echo "\n${BLUE}Restore:${NC} dockfolders reset"
    echo "${BLUE}Config:${NC} $CONFIG_FILE"
}

cmd_reset() {
    log_banner
    log_step "Finding latest backup"
    
    local latest
    latest=$(/bin/ls -dt "$BACKUP_DIR"/dock_backup_* 2>/dev/null | head -1)
    
    if [[ -z "$latest" ]]; then
        log_err "No backup found in $BACKUP_DIR"
        exit 1
    fi
    
    log_info "Restoring from: $latest"
    "$CP" "$latest/com.apple.dock.plist" ~/Library/Preferences/
    "$KILLALL" Dock
    log_ok "Dock restored"
}

cmd_discover() {
    log_banner
    log_step "Scanning installed apps"
    
    load_config ""
    
    # Collect all categorized apps
    typeset -A categorized
    for entry in "${CATEGORIES[@]}"; do
        local rest="${entry#*|}"
        local apps_csv="${rest#*|}"
        local apps=("${(@s:,:)apps_csv}")
        for app in "${apps[@]}"; do
            app="${app## }"; app="${app%% }"
            [[ -n "$app" ]] && categorized[$app]=1
        done
    done
    
    # Scan /Applications
    local uncategorized=()
    for app_path in /Applications/*.app(N) "$HOME/Applications"/*.app(N); do
        local name="${app_path:t:r}"  # filename without .app
        if [[ -z "${categorized[$name]:-}" ]]; then
            uncategorized+=("$name")
        fi
    done
    
    if [[ ${#uncategorized[@]} -eq 0 ]]; then
        log_ok "All apps categorized!"
    else
        log_warn "${#uncategorized[@]} uncategorized apps:"
        for app in "${uncategorized[@]}"; do
            echo "  ${DIM}•${NC} $app"
        done
        echo "\n${BLUE}Add them to:${NC} $CONFIG_FILE"
    fi
}

cmd_preset() {
    local preset_name="${1:-}"
    if [[ -z "$preset_name" ]]; then
        log_err "Usage: dockfolders preset <name>"
        echo "Available presets:"
        local script_dir="$(cd "$(dirname "$0")" && pwd)"
        for p in "$script_dir/presets"/*.sh(N); do
            echo "  • ${p:t:r}"
        done
        exit 1
    fi
    
    local script_dir="$(cd "$(dirname "$0")" && pwd)"
    local preset_file="$script_dir/presets/$preset_name.sh"
    
    if [[ ! -f "$preset_file" ]]; then
        log_err "Preset not found: $preset_name"
        exit 1
    fi
    
    "$MKDIR" -p "$CONFIG_DIR"
    "$CP" "$preset_file" "$CONFIG_FILE"
    log_ok "Applied preset: $preset_name"
    log_info "Run: dockfolders organize"
}

cmd_help() {
    cat <<EOF
${BOLD}DockFolders${NC} v${VERSION}
macOS Dock category organizer with emoji icons

${BOLD}USAGE:${NC}
  dockfolders <command> [options]

${BOLD}COMMANDS:${NC}
  ${GREEN}organize${NC}              Create folders and update Dock
  ${GREEN}organize${NC} --config F   Use specific config file
  ${GREEN}reset${NC}                 Restore Dock from latest backup
  ${GREEN}discover${NC}              Show uncategorized apps
  ${GREEN}preset${NC} <name>         Apply a preset config (developer, student, etc.)
  ${GREEN}help${NC}                  Show this help
  ${GREEN}version${NC}               Print version

${BOLD}CONFIG:${NC}
  ${CONFIG_FILE}

${BOLD}EXAMPLES:${NC}
  dockfolders organize
  dockfolders preset developer
  dockfolders discover
  dockfolders reset

${BOLD}LEARN MORE:${NC}
  https://github.com/Geonhee15/dockfolders
EOF
}

cmd_version() {
    echo "dockfolders v${VERSION}"
}

# ─── Main ───
main() {
    local cmd="${1:-help}"
    shift 2>/dev/null || true
    
    case "$cmd" in
        organize)  cmd_organize "$@" ;;
        reset)     cmd_reset "$@" ;;
        discover)  cmd_discover "$@" ;;
        preset)    cmd_preset "$@" ;;
        help|--help|-h)  cmd_help ;;
        version|--version|-v)  cmd_version ;;
        *)
            log_err "Unknown command: $cmd"
            echo "Run: dockfolders help"
            exit 1
            ;;
    esac
}

main "$@"
